              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a model"
        },
        {
          "info": {
            "name": "Get a model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lucidworks.ai/ai/models/:modelId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a model"
        }
      ]
    }
  ],
